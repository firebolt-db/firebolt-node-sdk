{
  "name": "firebolt-sdk",
  "version": "1.14.5",
  "description": "Official firebolt Node.JS sdk",
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "engines": {
    "node": ">=20.0"
  },
  "scripts": {
    "build": "rm -fr ./build && tsc -p tsconfig.lib.json",
    "release": "standard-version",
    "test": "jest",
    "test:ci": "node --expose-gc ./node_modules/.bin/jest --ci --bail",
    "type-check": "tsc -p tsconfig.lib.json",
    "lint": "eslint ."
  },
  "prettier": {
    "tabWidth": 2,
    "trailingComma": "none",
    "arrowParens": "avoid"
  },
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/node-fetch": "^2.5.12",
    "@types/rwlock": "^5.0.6",
    "allure-commandline": "^2.29.0",
    "allure-jest": "^3.13.0",
    "allure-js-commons": "^3.13.0",
    "dotenv": "^18.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "msw": "^1.3.5",
    "nock": "^15.0.1",
    "prettier": "^3.9.9",
    "standard-version": "^9.3.2",
    "ts-jest": "^29.1.2",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "@types/json-bigint": "^1.0.1",
    "abort-controller": "^3.0.0",
    "agentkeepalive": "^4.5.0",
    "json-bigint": "^1.0.0",
    "node-fetch": "^2.6.6",
    "rwlock": "^5.0.0"
  }
}
